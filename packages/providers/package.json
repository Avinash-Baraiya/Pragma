{
  "name": "@avinash-baraiya/pragma-providers",
  "version": "0.1.1",
  "description": "Language model providers for Pragma: OpenAI-compatible, Anthropic, Vercel AI SDK, mock and remote.",
  "keywords": [
    "pragma",
    "llm",
    "openai",
    "anthropic",
    "ai-sdk",
    "provider"
  ],
  "license": "MIT",
  "author": "Avinash Baraiya",
  "homepage": "https://pragma-docs.vercel.app/",
  "bugs": {
    "url": "https://github.com/Avinash-Baraiya/Pragma/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Avinash-Baraiya/Pragma.git",
    "directory": "packages/providers"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "openai-compatible": [
        "./dist/openai-compatible.d.ts"
      ],
      "anthropic": [
        "./dist/anthropic.d.ts"
      ],
      "ai-sdk": [
        "./dist/ai-sdk.d.ts"
      ],
      "mock": [
        "./dist/mock.d.ts"
      ],
      "remote": [
        "./dist/remote.d.ts"
      ],
      "gemini": [
        "./dist/gemini.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "@pragma/source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./openai-compatible": {
      "@pragma/source": "./src/openai-compatible.ts",
      "import": {
        "types": "./dist/openai-compatible.d.ts",
        "default": "./dist/openai-compatible.js"
      },
      "require": {
        "types": "./dist/openai-compatible.d.cts",
        "default": "./dist/openai-compatible.cjs"
      }
    },
    "./anthropic": {
      "@pragma/source": "./src/anthropic.ts",
      "import": {
        "types": "./dist/anthropic.d.ts",
        "default": "./dist/anthropic.js"
      },
      "require": {
        "types": "./dist/anthropic.d.cts",
        "default": "./dist/anthropic.cjs"
      }
    },
    "./ai-sdk": {
      "@pragma/source": "./src/ai-sdk.ts",
      "import": {
        "types": "./dist/ai-sdk.d.ts",
        "default": "./dist/ai-sdk.js"
      },
      "require": {
        "types": "./dist/ai-sdk.d.cts",
        "default": "./dist/ai-sdk.cjs"
      }
    },
    "./mock": {
      "@pragma/source": "./src/mock.ts",
      "import": {
        "types": "./dist/mock.d.ts",
        "default": "./dist/mock.js"
      },
      "require": {
        "types": "./dist/mock.d.cts",
        "default": "./dist/mock.cjs"
      }
    },
    "./remote": {
      "@pragma/source": "./src/remote.ts",
      "import": {
        "types": "./dist/remote.d.ts",
        "default": "./dist/remote.js"
      },
      "require": {
        "types": "./dist/remote.d.cts",
        "default": "./dist/remote.cjs"
      }
    },
    "./gemini": {
      "@pragma/source": "./src/gemini.ts",
      "import": {
        "types": "./dist/gemini.d.ts",
        "default": "./dist/gemini.js"
      },
      "require": {
        "types": "./dist/gemini.d.cts",
        "default": "./dist/gemini.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:package": "publint --strict && attw --pack . --profile node16"
  },
  "dependencies": {
    "@avinash-baraiya/pragma-core": "workspace:^",
    "@avinash-baraiya/pragma-interpreter": "workspace:^"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.128.0",
    "ai": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "ai": "^7.0.118"
  }
}
