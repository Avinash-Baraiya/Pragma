{
  "name": "@avinash-baraiya/pragma-server",
  "version": "0.1.0",
  "description": "Web-standard HTTP handler for Pragma natural-language table queries.",
  "keywords": [
    "pragma",
    "server",
    "http",
    "llm",
    "table",
    "query"
  ],
  "license": "MIT",
  "author": "Avinash Baraiya",
  "homepage": "https://avinash-baraiya.github.io/Pragma/",
  "bugs": {
    "url": "https://github.com/Avinash-Baraiya/Pragma/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Avinash-Baraiya/Pragma.git",
    "directory": "packages/server"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@pragma/source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:package": "publint --strict && attw --pack . --profile node16"
  },
  "dependencies": {
    "@avinash-baraiya/pragma-core": "workspace:^",
    "@avinash-baraiya/pragma-interpreter": "workspace:^",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@avinash-baraiya/pragma-providers": "workspace:^"
  }
}
