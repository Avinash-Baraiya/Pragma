{
  "name": "@pragma/core",
  "version": "0.0.0",
  "description": "Pragma core: schema model, TableQuery protocol, operators, validator, normalizer, mutations, dates, reference executor.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@pragma/source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:package": "publint --strict && attw --pack . --profile node16"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "zod": "^4.6.5"
  }
}
