{
  "name": "@avinash-baraiya/pragma-core",
  "version": "0.0.0",
  "description": "Schema model, TableQuery protocol, validation and reference execution for natural-language table queries.",
  "keywords": [
    "pragma",
    "table",
    "query",
    "filter",
    "schema",
    "validation"
  ],
  "license": "MIT",
  "author": "Avinash Baraiya",
  "homepage": "https://github.com/Avinash-Baraiya/Pragma/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/Avinash-Baraiya/Pragma/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Avinash-Baraiya/Pragma.git",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@pragma/source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:package": "publint --strict && attw --pack . --profile node16"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "zod": "^4.6.5"
  }
}
