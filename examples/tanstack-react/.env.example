# Which model interprets instructions the deterministic parser does not cover.
# mock (default, offline) | openai-compatible | anthropic
PRAGMA_PROVIDER=mock

# OpenAI-compatible servers: OpenAI, OpenRouter, Groq, Ollama (http://localhost:11434/v1), vLLM, LM Studio, ...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
OPENAI_API_KEY=

# Anthropic (requires the optional @anthropic-ai/sdk peer dependency)
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_API_KEY=
